# Copy to .env and set your own key. Never commit real API keys.
OPENAI_API_KEY=<replace with your key>
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
# Enables durable workflow and audit persistence. Uses the same PostgreSQL database as the Java app,
# but only creates tables prefixed with orchestrator_.
DATABASE_URL=postgresql://shortener:shortener@localhost:5432/shortener
# Optional absolute path to the repository root; leave blank to auto-detect.
PROJECT_ROOT=
MAVEN_TEST_TIMEOUT_SECONDS=300
